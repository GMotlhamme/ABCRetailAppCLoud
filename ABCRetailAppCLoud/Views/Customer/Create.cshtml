@model ABCRetailAppCLoud.Models.Customer

@{
    ViewData["Title"] = "Create Customer";
}

<div class="container py-5" style="max-width: 520px;">
    <div class="dark-container p-4">
        <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom border-dark">
            <h5 class="fw-bold mb-0 text-white">CREATE CUSTOMER</h5>
            <span class="badge-tag">NEW ENTRY</span>
        </div>

        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="FullName" class="form-label text-secondary small fw-bold">FULL NAME</label>
                <input asp-for="FullName" class="form-control dark-input" placeholder="e.g. John Doe" required />
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label text-secondary small fw-bold">EMAIL ADDRESS</label>
                <input asp-for="Email" type="email" class="form-control dark-input" placeholder="name@domain.com" required />
            </div>

            <div class="row g-2 mb-4">
                <div class="col-8">
                    <label asp-for="Address" class="form-label text-secondary small fw-bold">ADDRESS</label>
                    <input asp-for="Address" class="form-control dark-input" placeholder="123 Main St" required />
                </div>
                <div class="col-4">
                    <label asp-for="City" class="form-label text-secondary small fw-bold">CITY</label>
                    <input asp-for="City" class="form-control dark-input" placeholder="New York" required />
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-dark">
                <a asp-action="Index" class="btn-bracket text-secondary">[ CANCEL ]</a>
                <button type="submit" class="btn btn-bracket border border-success text-success px-4">[ CREATE ]</button>
            </div>
        </form>
    </div>
</div>