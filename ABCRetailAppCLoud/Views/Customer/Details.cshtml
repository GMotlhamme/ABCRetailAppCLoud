@model Customer

<h2>Customer Details</h2>

<div>
    <h4>@Model.FullName</h4>

    <p>
        <strong>Email:</strong>
        @Model.Email
    </p>

    <p>
        <strong>Address:</strong>
        @Model.Address
    </p>

    <p>
        <strong>City:</strong>
        @Model.City
    </p>
</div>

<a asp-action="Edit"
   asp-route-partitionKey="@Model.PartitionKey"
   asp-route-rowKey="@Model.RowKey">
    Edit
</a>

<a asp-action="Index">
    Back to Customers
</a>