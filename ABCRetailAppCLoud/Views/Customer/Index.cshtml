@model IEnumerable<Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="container-fluid py-4 px-md-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-1 mb-2 px-2 py-1" style="font-size: 0.65rem; letter-spacing: 0.1em;">CUSTOMERS</span>
            <h2 class="fw-bold mb-0 text-white fs-4">Customer Directory</h2>
        </div>
        <a href="@Url.Action("Create")" class="btn btn-bracket border border-secondary rounded-1 px-3 py-2">
            + CREATE CUSTOMER
        </a>
    </div>

    <!-- Dark Table Card -->
    <div class="dark-container overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark-custom">
                <thead>
                    <tr>
                        <th>CUSTOMER</th>
                        <th>EMAIL</th>
                        <th>ADDRESS</th>
                        <th>CITY</th>
                        <th class="text-end">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                NO CUSTOMERS RECORDED
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-dark border border-secondary d-flex align-items-center justify-content-center text-white-50 fw-bold" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                            @(string.IsNullOrEmpty(customer.FullName) ? "C" : customer.FullName.Substring(0, 1).ToUpper())
                                        </div>
                                        <span class="fw-semibold">@customer.FullName</span>
                                        <i class="bi bi-patch-check-fill text-success ms-1" style="font-size: 0.8rem;"></i>
                                    </div>
                                </td>
                                <td class="text-secondary">@customer.Email</td>
                                <td class="text-secondary">@customer.Address</td>
                                <td>
                                    <span class="badge-tag">@customer.City</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex align-items-center gap-2">
                                        <a href="@Url.Action("Details", new { partitionKey = customer.PartitionKey, rowKey = customer.RowKey })" class="btn-bracket">[DETAILS]</a>
                                        <a href="@Url.Action("Edit", new { partitionKey = customer.PartitionKey, rowKey = customer.RowKey })" class="btn-bracket">[EDIT]</a>

                                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure?');">
                                            <input type="hidden" name="partitionKey" value="@customer.PartitionKey" />
                                            <input type="hidden" name="rowKey" value="@customer.RowKey" />
                                            <button type="submit" class="btn-bracket btn-bracket-danger">[DELETE]</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>