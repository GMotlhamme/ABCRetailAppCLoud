@model ABCRetailAppCLoud.Models.OrderMessage

@{
    ViewData["Title"] = "Create Order";
}

<div class="container py-5" style="max-width: 520px;">
    <div class="dark-container p-4">
        <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom border-dark">
            <h5 class="fw-bold mb-0 text-white">CREATE ORDER</h5>
            <span class="badge-tag">NEW TRANSACTION</span>
        </div>

        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label class="form-label text-secondary small fw-bold">CUSTOMER</label>
                <select asp-for="CustomerId" class="form-select dark-input font-monospace">
                    <option value="">-- Select Customer --</option>
                    @if (ViewBag.Customers != null)
                    {
                        @foreach (var customer in ViewBag.Customers)
                        {
                            <option value="@customer.RowKey">
                                @customer.FullName
                            </option>
                        }
                    }
                </select>
                <span asp-validation-for="CustomerId" class="text-danger small font-monospace"></span>
            </div>

            <div class="mb-3">
                <label class="form-label text-secondary small fw-bold">PRODUCT</label>
                <select asp-for="ProductId" class="form-select dark-input font-monospace">
                    <option value="">-- Select Product --</option>
                    @if (ViewBag.Products != null)
                    {
                        @foreach (var product in ViewBag.Products)
                        {
                            <option value="@product.RowKey">
                                @product.ProductName
                            </option>
                        }
                    }
                </select>
                <span asp-validation-for="ProductId" class="text-danger small font-monospace"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Quantity" class="form-label text-secondary small fw-bold">QUANTITY</label>
                <input asp-for="Quantity" type="number" min="1" class="form-control dark-input font-monospace" placeholder="1" required />
                <span asp-validation-for="Quantity" class="text-danger small font-monospace"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-dark">
                <a asp-action="Index" class="btn-bracket text-secondary">[ CANCEL ]</a>
                <button type="submit" class="btn btn-bracket border border-success text-success px-4">[ PLACE ORDER ]</button>
            </div>
        </form>
    </div>
</div>