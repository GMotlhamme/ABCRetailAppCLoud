@model List<ABCRetailAppCLoud.Models.OrderMessage>

@{
    ViewData["Title"] = "Orders Queue";
}

<div class="container-fluid py-4 px-md-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-1 mb-2 px-2 py-1" style="font-size: 0.65rem; letter-spacing: 0.1em;">QUEUE</span>
            <h2 class="fw-bold mb-0 text-white fs-4">Orders Queue</h2>
        </div>
        <a asp-action="Create" class="btn btn-bracket border border-secondary rounded-1 px-3 py-2 text-white">
            + CREATE ORDER
        </a>
    </div>

    <!-- Dark Table Card -->
    <div class="dark-container overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark-custom">
                <thead>
                    <tr>
                        <th>ORDER ID</th>
                        <th>CUSTOMER ID</th>
                        <th>PRODUCT ID</th>
                        <th>ACTION</th>
                        <th>QUANTITY</th>
                        <th class="text-end">CREATED AT</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                NO ORDERS IN QUEUE
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var message in Model)
                        {
                            <tr>
                                <td>
                                    <span class="font-monospace fw-bold text-white">#@message.OrderId</span>
                                </td>
                                <td class="text-secondary font-monospace">@message.CustomerId</td>
                                <td class="text-secondary font-monospace">@message.ProductId</td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace" style="font-size: 0.7rem;">
                                        @(string.IsNullOrEmpty(message.Action) ? "PROCESSED" : message.Action.ToUpper())
                                    </span>
                                </td>
                                <td class="text-white fw-bold font-monospace">@message.Quantity</td>
                                <td class="text-end text-secondary font-monospace">
                                    @message.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>