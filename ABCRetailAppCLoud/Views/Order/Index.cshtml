@model List<ABCRetailAppCLoud.Models.OrderMessage>

<h2>Orders Queue</h2>

<table class="table">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Customer ID</th>
            <th>Product ID</th>
            <th>Action</th>
            <th>Quantity</th>
            <th>Created At</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var message in Model)
        {
            <tr>
                <td>@message.OrderId</td>
                <td>@message.CustomerId</td>
                <td>@message.ProductId</td>
                <td>@message.Action</td>
                <td>@message.Quantity</td>
                <td>@message.CreatedAt</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">
    Create Order
</a>