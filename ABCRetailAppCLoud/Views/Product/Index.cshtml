@model IEnumerable<Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container-fluid py-4 px-md-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-1 mb-2 px-2 py-1" style="font-size: 0.65rem; letter-spacing: 0.1em;">INVENTORY</span>
            <h2 class="fw-bold mb-0 text-white fs-4">Product Catalog</h2>
        </div>
        <a href="@Url.Action("Create")" class="btn btn-bracket border border-secondary rounded-1 px-3 py-2 text-white">
            + CREATE PRODUCT
        </a>
    </div>

    <!-- Dark Table Card -->
    <div class="dark-container overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark-custom">
                <thead>
                    <tr>
                        <th style="width: 70px;">IMAGE</th>
                        <th>PRODUCT NAME</th>
                        <th>DESCRIPTION</th>
                        <th>PRICE</th>
                        <th class="text-end">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                NO PRODUCTS RECORDED
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>
                                    <div class="rounded bg-dark border border-secondary overflow-hidden d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                        @if (!string.IsNullOrEmpty(product.ProductImage))
                                        {
                                            <img src="@product.ProductImage" alt="@product.ProductName" style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-box-seam text-secondary"></i>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-semibold text-white">@product.ProductName</span>
                                </td>
                                <td class="text-secondary text-truncate" style="max-width: 250px;">
                                    @product.Description
                                </td>
                                <td>
                                    <span class="fw-bold text-success font-monospace">R @product.Price</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex align-items-center gap-2">
                                        <a href="@Url.Action("Details", new { partitionKey = product.PartitionKey, rowKey = product.RowKey })" class="btn-bracket">[DETAILS]</a>
                                        <a href="@Url.Action("Edit", new { partitionKey = product.PartitionKey, rowKey = product.RowKey })" class="btn-bracket">[EDIT]</a>

                                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                            <input type="hidden" name="partitionKey" value="@product.PartitionKey" />
                                            <input type="hidden" name="rowKey" value="@product.RowKey" />
                                            <button type="submit" class="btn-bracket btn-bracket-danger">[DELETE]</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>