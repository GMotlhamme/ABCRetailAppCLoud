@model Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container py-5" style="max-width: 540px;">
    <div class="dark-container p-4">
        <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom border-dark">
            <h5 class="fw-bold mb-0 text-white">EDIT PRODUCT</h5>
            <span class="badge-tag">ID: @Model.RowKey</span>
        </div>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="PartitionKey" />
            <input type="hidden" asp-for="RowKey" />

            <div class="mb-3">
                <label asp-for="ProductName" class="form-label text-secondary small fw-bold">PRODUCT NAME</label>
                <input asp-for="ProductName" class="form-control dark-input" />
                <span asp-validation-for="ProductName" class="text-danger small font-monospace"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label text-secondary small fw-bold">DESCRIPTION</label>
                <textarea asp-for="Description" class="form-control dark-input" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small font-monospace"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label text-secondary small fw-bold">PRICE (R)</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control dark-input" />
                <span asp-validation-for="Price" class="text-danger small font-monospace"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ProductImage))
            {
                <div class="mb-3">
                    <label class="form-label text-secondary small fw-bold d-block">CURRENT IMAGE</label>
                    <div class="rounded bg-dark border border-secondary p-2 d-inline-block">
                        <img src="@Model.ProductImage" alt="@Model.ProductName" style="max-height: 80px; object-fit: contain;" />
                    </div>
                </div>
            }

            <div class="mb-4">
                <label class="form-label text-secondary small fw-bold">CHANGE IMAGE</label>
                <input type="file" name="file" accept="image/*" class="form-control dark-input" />
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-dark">
                <a asp-action="Index" class="btn-bracket text-secondary">[ CANCEL ]</a>
                <button type="submit" class="btn btn-bracket border border-success text-success px-4">[ SAVE CHANGES ]</button>
            </div>
        </form>
    </div>
</div>