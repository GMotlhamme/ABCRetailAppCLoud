@model List<ABCRetailAppCLoud.Models.FileUpload>

<h2>Stored Files</h2>

<a asp-action="Create" class="btn btn-primary">
    Upload File
</a>

<table class="table">
    <thead>
        <tr>
            <th>File Name</th>
            <th>File Size</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var file in Model)
        {
            <tr>
                <td>@file.FileName</td>
                <td>@file.FileSize bytes</td>
                <td>
                    <a asp-action="Download" 
                       asp-route-fileName="@file.FileName"
                       class="btn btn-dark">
                        Download
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>