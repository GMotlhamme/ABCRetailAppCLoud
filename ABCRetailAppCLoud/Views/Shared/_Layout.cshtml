<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ABCRetailAppCloud</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ABCRetailAppCLoud.styles.css" asp-append-version="true" />
</head>
<body class="bg-dark text-light min-vh-100 d-flex flex-column">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark border-bottom border-dark bg-dark py-2">
            <div class="container-fluid px-md-4">
                <a class="navbar-brand fw-bold font-monospace d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="text-success" style="font-size: 0.8rem;">●</span> ABC_RETAIL
                </a>
                <button class="navbar-toggler border-secondary" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 font-monospace small">
                        <li class="nav-item">
                            <a class="nav-link text-secondary" asp-area="" asp-controller="Home" asp-action="Index">[ HOME ]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary" asp-area="" asp-controller="Customer" asp-action="Index">[ CUSTOMERS ]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary" asp-area="" asp-controller="Product" asp-action="Index">[ PRODUCTS ]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary" asp-area="" asp-controller="Order" asp-action="Index">[ ORDERS ]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary" asp-area="" asp-controller="File" asp-action="Index">[ FILES ]</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        <a class="nav-link text-secondary small font-monospace" asp-area="" asp-controller="Home" asp-action="Privacy">[ PRIVACY ]</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-md-4 flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top border-dark py-3 mt-auto bg-dark">
        <div class="container-fluid px-md-4 text-secondary small font-monospace d-flex justify-content-between align-items-center">
            <div>
                &copy; 2026 ABCRetailAppCloud
            </div>
            <div>
                <span class="badge-tag">SYSTEM ONLINE</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>